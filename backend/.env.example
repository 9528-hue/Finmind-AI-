# FINMIND AI Backend environment variables.
# Copy to .env and set strong, private values before starting the backend.
# Never commit .env files containing secrets.

# SQLite for local development:
DATABASE_URL=sqlite:///./finmind.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/finmind

# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. AI chat reports unavailable until configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used when a transaction row does not provide a currency.
DEFAULT_CURRENCY=INR
